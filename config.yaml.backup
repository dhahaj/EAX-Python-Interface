app_name: "EAX500 Interface"
app_version: "1.0.0"

firmware:
  path: ./firmware
  files:
    - filename: EAX300_591.hex
      basename: EAX300
      version: "591"
    - filename: EAX500_591.hex
      basename: EAX500
      version: "591"
    - filename: EAX503_591.hex
      basename: EAX503
      version: "591"
    - filename: EAX504_591.hex
      basename: EAX504
      version: "591"
    - filename: EAX505_591.hex
      basename: EAX505
      version: "591"
    - filename: EAX510_591.hex
      basename: EAX510
      version: "591"
    - filename: EAX513_591.hex
      basename: EAX513
      version: "591"
    - filename: EAX514_591.hex
      basename: EAX514
      version: "591"
    - filename: EAX515_591.hex
      basename: EAX515
      version: "591"
    - filename: EAX520_591.hex
      basename: EAX520
      version: "591"
    - filename: EAX523_591.hex
      basename: EAX523
      version: "591"
    - filename: EAX524_591.hex
      basename: EAX524
      version: "591"
    - filename: EAX525_591.hex
      basename: EAX525
      version: "591"

# defines the test sequence
testing:
  - description: Test Indicator On
    command: digital_write
    params: [13, 1]
    delay: 1
  - description: Show Text
    command: insert_text
    params: ["\n • Battery power on → Siren chirps and both LEDs flash  \n"]
    delay: 1
  - description: Battery On
    command: digital_write
    params: [4, 1]
    delay: 1
  - description: Show Text
    command: insert_text
    params: ["\n • Starting low battery test → LEDs flash alternating \n"]
    delay: null
  - description: Low Battery On
    command: digital_write
    params: [2, 1]
    delay: 1
  - description: Show Text
    command: insert_text
    params: ["\n • Low battery test off → LEDs turn off.\n"]
    delay: null
  - description: Low Battery Off
    command: digital_write
    params: [2, 0]
    delay: 1
  - description: Show Text
    command: insert_text
    params: [" • Perform the following:\n \t1. Press the key switch → The siren sounds\n \t2. Press the cylinder switch → The LEDs turn on\n"]
    delay: 500
  - description: Show Text
    command: insert_text
    params: ["\n\nPress the Continue button to finish testing..."]
    delay: 200
  - description: Wait for Button
    command: wait_for_button
    params: [15000]
    delay: 1
  - description: Show Text
    command: insert_text
    params: ["\n Test complete.\n"]
    delay: 1
  - description: Test Indicator Off
    command: digital_write
    params: [13, 0]
    delay: 1
  - description: Battery Off
    command: digital_write
    params: [4, 0]
    delay: 1
  - description: Load Instructions
    command: load_instructions
    params: [instructions.md]
    delay: 10

settings:
  serial_port: COM30
  programmer_serial_number: 1E660
  chip_part: PIC16F628A
  last_user: dmh
  testing_speed: 2100
  auto_test: true
  font_family: Consolas
  font_size: 14
  font_weight: normal
  skip_login: false
  auto_connect: true
  arduino_instance_id: 1
  debug: true
  firmware_folder: firmware
  auto_logoff_delay: 15
  bg_color: "#000000"
  fg_color: "#ff5500"
  arduino_wait: 4
  shutdown_on_exception: true
  auto_find: true
  sleep_tune: 1e-06
  full_screen: false
  touchscreen_enabled: false
  frameless: false

pins:
  - pin_number: 2
    io_mode: output
    function: low battery
    pullup_enabled: false
  - pin_number: 3
    io_mode: output
    function: test mode
    pullup_enabled: false
  - pin_number: 4
    io_mode: output
    function: battery
    pullup_enabled: false
  - pin_number: 5
    io_mode: output
    function: remote
    pullup_enabled: false
  - pin_number: 6
    io_mode: output
    function: pad
    pullup_enabled: false
  - pin_number: 7
    io_mode: input
    function: relay in
    pullup_enabled: true
  - pin_number: 8
    io_mode: output
    function: okc
    pullup_enabled: false
  - pin_number: 9
    io_mode: output
    function: ac
    pullup_enabled: false
  - pin_number: 10
    io_mode: output
    function: indicator
    pullup_enabled: false
  - pin_number: 11
    io_mode: output
    function: relay1
    pullup_enabled: false
  - pin_number: 12
    io_mode: output
    function: relay2
    pullup_enabled: false
  - pin_number: 13
    io_mode: output
    function: test indicator
    pullup_enabled: false

