{
    "editor.codeActionsOnSave": {},
    "actionButtons": {
        "defaultColor": "#ff0034",
        "loadNpmCommands": false,
        "reloadButton": null,
        "commands": [
          {
            "name": "Run Main",
            "singleInstance": true,
            "color": "#ffe65c",
            "cwd": "${workspaceFolder}",
            "command": "venv\\scripts\\python main.py"
          },
          {
            "name": "Open Designer",
            "singleInstance": true,
            "color": "#00ffe1",
            "cwd": "${workspaceFolder}",
            "command": "venv\\scripts\\pyside6-designer QtDesigner\\mainwindow.ui"
          },
          {
            "name": "QtDesigner",
            "singleInstance": true,
            "color": "#ffe65c",
            "cwd": "${workspaceFolder}",
            "command": ".venv\\scripts\\pyside6-designer QtDesigner\\MainWindow.ui"
          },
        ]
    },
    "isort.interpreter": [
      "C:\\Python311\\python.exe"
    ],
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.exclude": [
      "**/dist",
      ".git",
      "**/build",
      "**/venv",
      "**/.venv",
      ".venv/*",
      "venv/*"
    ],
    "autoDocstring.logLevel": "Info",
    "autoDocstring.includeName": false,
    "autoDocstring.startOnNewLine": true,
    "[python]": {
      // "editor.defaultFormatter": "ms-python.autopep8"
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.formatOnSave": true
    },
    "python.languageServer": "Default",
    "multiFormatter.formatterList": [
      "autopep8"
    ],
    "python.analysis.autoFormatStrings": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.fixAll": [],
    "python.autoComplete.extraPaths": [],
    "python.envFile": "${workspaceFolder}/.venv/pyvenv.cfg",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "black-formatter.interpreter": [
      "${workspaceFolder}/.venv/Scripts/python"
    ],
    "black-formatter.args": [
      "--skip-string-normalization",
      "--line-length=150",
      // "--max-line-length=150",
    ],
    "python.analysis.extraPaths": [],
    "files.associations": {
      "*.src": "pic-assembly",
      "*.py": "python",
      "*.v": "verilog",
      "ostream": "c"
    },
    "C_Cpp.errorSquiggles": "disabled",
    "python.formatting.provider": "yapf",
    "qtForPython.uic.options": [
      "-o",
      "${resourceDirname}${pathSeparator}..${pathSeparator}ui${pathSeparator}ui_${resourceBasenameNoExtension}.py"
    ]
}