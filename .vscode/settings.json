{
    "editor.codeActionsOnSave": {},
    "actionButtons": {
        "defaultColor": "#ff0034",
        "loadNpmCommands": false,
        "reloadButton": null,
        "commands": [
            {
                "name": "Run Main",
                "singleInstance": true,
                "color": "#ffe65c",
                "cwd": "${workspaceFolder}",
                "command": ".venv\\scripts\\python main.py"
            },
            {
                "name": "Resource RC",
                "singleInstance": true,
                "color": "lightpink",
                "cwd": "${workspaceFolder}",
                "command": ".venv\\scripts\\pyside6-rcc.exe -o resource_rc.py resource.qrc"
            },
            {
                "name": "Icons RC",
                "singleInstance": true,
                "color": "lightpink",
                "cwd": "${workspaceFolder}",
                "command": ".venv\\scripts\\pyside6-rcc.exe -o icons_rc.py icons.qrc"
            },
            {
                "name": "MainWindow UIC",
                "singleInstance": true,
                "color": "lightpink",
                "cwd": "${workspaceFolder}",
                "command": ".venv\\scripts\\pyside6-uic.exe -o ui/ui_MainWindow.py QtDesigner/MainWindow.ui"
            },
            {
                "name": "Settings UIC",
                "singleInstance": true,
                "color": "lightpink",
                "cwd": "${workspaceFolder}",
                "command": ".venv\\scripts\\pyside6-uic.exe -o ui/ui_Settings.py QtDesigner/Settings.ui"
            },
            {
                "name": "Resources RC",
                "singleInstance": true,
                "color": "#00ffe1",
                "cwd": "${workspaceFolder}",
                "command": ".venv\\scripts\\pyside6-rcc.exe -o util/config_resources_rc.py util/config_resources.qrc"
            },
            {
                "name": "QtDesigner",
                "singleInstance": true,
                "color": "#ffe65c",
                "cwd": "${workspaceFolder}",
                "command": ".venv\\scripts\\pyside6-designer QtDesigner\\MainWindow.ui"
            }
        ]
    },
    "isort.interpreter": ["C:\\Python311\\python.exe"],
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.extraPaths": [
        ".venv\\src\\telemetrix-aio",
        ".venv\\src\\ini-py"
    ],
    "python.analysis.include": [
        ".venv\\src\\telemetrix-aio\\telemetrix_aio\\**",
        ".venv/src/telemetrix-aio/telemetrix_aio/telemetrix_aio.py"
    ],
    "python.analysis.exclude": [
        // "**/dist",
        // ".git",
        // "**/build",
        // "**/.venv",
        // ".venv/*",
        // "util\\config_resources_rc.py"
    ],
    "autoDocstring.logLevel": "Info",
    "autoDocstring.includeName": false,
    "autoDocstring.startOnNewLine": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8"
        // "editor.defaultFormatter": "ms-python.black-formatter",
        // "editor.formatOnSave": true
    },
    "github.copilot.advanced": {
        "debug.useElectronFetcher": false
    },
    "python.languageServer": "Default",
    "multiFormatter.formatterList": ["autopep8"],
    "python.analysis.autoFormatStrings": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.fixAll": [],
    "python.autoComplete.extraPaths": [],
    "python.envFile": "${workspaceFolder}/.venv/pyvenv.cfg",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "black-formatter.interpreter": ["${workspaceFolder}/.venv/Scripts/python"],
    "black-formatter.args": [
        "--skip-string-normalization",
        "--line-length=125",
        "--target-version=py313",
        "--skip-magic-trailing-comma"
        // "--max-line-length=150",`
    ],
    "files.associations": {
        "*.src": "pic-assembly",
        "*.py": "python",
        "*.v": "verilog",
        "ostream": "c",
        "*.yaml": "home-assistant",
        "*.spec": "python",
        "*.qrc": "xml",
        "*.ui": "xml",
        "windows.h": "c",
        "shellapi.h": "c",
        "*.ppr": "ini"
    },
    "C_Cpp.errorSquiggles": "disabled",
    "python.formatting.provider": "yapf",
    "qtForPython.uic.options": [
        "-o",
        "${resourceDirname}${pathSeparator}..${pathSeparator}ui${pathSeparator}ui_${resourceBasenameNoExtension}.py"
    ],
    "editor.mouseWheelZoom": true,
    "python.analysis.addHoverSummaries": true,
    "python.analysis.aiCodeActions": {
        "convertFormatString": true,
        "implementAbstractClasses": true
    },
    "python.analysis.enableTroubleshootMissingImports": true,
    "python.analysis.inlayHints.callArgumentNames": "all",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.typeEvaluation.strictSetInference": true,
    "python.analysis.typeEvaluation.analyzeUnannotatedFunctions": false
}
