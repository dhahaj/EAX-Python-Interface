        <widget class="QTextBrowser" name="textBrowser_usage">
         <property name="html">
          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;title&gt;Usage&lt;/title&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Segoe UI'; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;h1 style=&quot; margin-top:18px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a name=&quot;usage&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:xx-large; font-weight:700;&quot;&gt;U&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:xx-large; font-weight:700;&quot;&gt;sage&lt;/span&gt;&lt;/h1&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a name=&quot;table-of-contents&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:x-large; font-weight:700;&quot;&gt;T&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:x-large; font-weight:700;&quot;&gt;able of Contents&lt;/span&gt;&lt;/h2&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a href=&quot;#usage&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Usage&lt;/span&gt;&lt;/a&gt; 
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 2;&quot;&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a href=&quot;#table-of-contents&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Table of Contents&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a href=&quot;#installation&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Installation&lt;/span&gt;&lt;/a&gt; 
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 3;&quot;&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a href=&quot;#new-features&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;New Features&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a href=&quot;#gui&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;GUI&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a href=&quot;#settings&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Settings&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a href=&quot;#firmware&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Firmware&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a name=&quot;installation&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:x-large; font-weight:700;&quot;&gt;I&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:x-large; font-weight:700;&quot;&gt;nstallation&lt;/span&gt;&lt;/h2&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;Install the firmware to the test fixture. See the &lt;a href=&quot;#firmware&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Firmware&lt;/span&gt;&lt;/a&gt; section for more information.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;The programming software called &lt;span style=&quot; font-family:'Courier New';&quot;&gt;up.exe&lt;/span&gt; provided for by &lt;a href=&quot;https://www.asix.net/&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Asix&lt;/span&gt;&lt;/a&gt; is required for programming.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;Install Python 3.7 or later from &lt;a href=&quot;https://www.python.org/&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Python.org&lt;/span&gt;&lt;/a&gt;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;Run &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Start.bat&lt;/span&gt; from the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Scrpts&lt;/span&gt; directory to start the application.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;Install the required Python package dependencies listed in &lt;span style=&quot; font-family:'Courier New';&quot;&gt;requirements.txt&lt;/span&gt; using the command &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pip install -r requirements.txt&lt;/span&gt;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;A standalone executable can be created using &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pyinstaller&lt;/span&gt;. Install &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pyinstaller&lt;/span&gt; using the command &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pip install pyinstaller&lt;/span&gt;. (Optional)&lt;/li&gt;&lt;/ol&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;The EAX Test Interface is an improvement over the last version. The interface was written in pure Python using the &lt;/span&gt;&lt;a href=&quot;https://doc.qt.io/qtforpython-6/&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px; text-decoration: underline; color:#7cfbfc;&quot;&gt;Pyside6&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; library and &lt;/span&gt;&lt;a href=&quot;https://www.qt.io/&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px; text-decoration: underline; color:#7cfbfc;&quot;&gt;Qt&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; framwork. The improvements are listed below:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;Using an improved firmware for communicating with the fixture. It includes improvements to both the communication speed and allows for multiple devices to be connected to the same computer.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Install.PS1&lt;/span&gt; script can be used to automatically download and install the latest firmware. Requires an internet connection. See the &lt;a href=&quot;#firmware&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Firmware&lt;/span&gt;&lt;/a&gt; section for more information.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;The settings are now stored in a plaint text file called &lt;span style=&quot; font-family:'Courier New';&quot;&gt;settings.json&lt;/span&gt;. This file contains a JSON object that represents all the runtime settings. There should not be any need to modify this file as all the settings can be changed in the application.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;The pin assignments are now stored in a plain text file called &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pins.json&lt;/span&gt;. This file contains a JSON object that represents all the pin assignments. There should not be any need to modify this file as all the pin assignments can be changed in the application. The EAX Test Interface is an improvement over the last version. The interface was written in pure Python using the &lt;a href=&quot;https://doc.qt.io/qtforpython-6/&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Pyside6&lt;/span&gt;&lt;/a&gt; and Qt framwork. The improvements are listed below:&lt;/li&gt;&lt;/ul&gt;
&lt;h3 style=&quot; margin-top:14px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a name=&quot;new-features&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;N&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;ew Features&lt;/span&gt;&lt;/h3&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;Changing the serial numbers for the programmer can be done directly now in the settings menu. See the &lt;a href=&quot;#settings&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#7cfbfc;&quot;&gt;Settings&lt;/span&gt;&lt;/a&gt; section for more information.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;The login process can be skipped by enabling the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Auto Login&lt;/span&gt; setting. Note to avoid the possibility of a user accidentally modifying the settings, a person will still be required to login as an administrator to change the settings.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;The application can automatically find the correct USB port by enabling the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Auto Find&lt;/span&gt; setting. It will scan and test all USB ports and automatically connect to the correct one. The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Auto Connect&lt;/span&gt; setting will automatically connect to the fixture when the application is started.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;If for some reason two fixtures are to be connected to the same computer, the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;arduino_instance_id&lt;/span&gt; setting can be changed so that the application will only connect to the fixture with the matching &lt;span style=&quot; font-family:'Courier New';&quot;&gt;arduino_instance_id&lt;/span&gt;. Note that to do this, the firmware will need to be recompilled and uploaded to the test fixture.&lt;/li&gt;&lt;/ol&gt;
&lt;h3 style=&quot; margin-top:14px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a name=&quot;gui&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;G&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;UI&lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;The main window is composed of a text console, two buttons and two labels. The text console is used for displaying messages, and the buttons are used for programming and testing. The two text labels are used for displaying the status of the USB connection and the currently selected device. The menu bar contains the &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;File&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Device&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Settings&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; and &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Help&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; menus. The &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;File&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; menu contains items for logging in and out, connecting and disconnecting from the fixture, and exiting the application. The &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Device&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; menu contains items for selecting the device. The &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Settings&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; menu contains various items for modifying the settings. The &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Help&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; menu contains items for displaying the debugging logs and displaying the about dialog.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;img src=&quot;file:///c:\Users\dhaha\Documents\Work\Testers\EAX-Python-Interface\images\MainWindow.png&quot; alt=&quot;alt text&quot; width=&quot;550&quot; /&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:4px; margin-bottom:2px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a name=&quot;settings&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;S&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;ettings&lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;The settings can be changed by clicking on the &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Modify Settings&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; menu item. This will open up a new window as shown below. Any changes made on this window will not be applied until the &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Save&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; button is pressed. The &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Default&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; button will reset all the settings to their default values. The dial on the bottom right can be used to change the testing speed. Rotating it CW will increase the speed and CCW will decrease the speed. The exact timing is shown just above the dial, which is specified in ms. The &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Debug&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; checkbox just enables additional debug messages to be printed to the console and to the log file. The &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Auto Logoff Delay&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; is the amount of time in minutes before the application will automatically logoff the current user (note that this is only valid if &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Auto Login&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; is disabled). The &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Chip&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; combobox is used to select the particular chip that is populated on the EAX board. This setting can be changed here or by selecting &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Chip Select&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; from the settings menu. All the items in the &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Advanced&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; section should not be changed unless you know what you are doing. These settings modify how the application interacts with the fixture and the firmware.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:2px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;img src=&quot;file:///c:\Users\dhaha\Documents\Work\Testers\EAX-Python-Interface\images\SettingsMenu.png&quot; alt=&quot;alt text&quot; /&gt;&lt;br /&gt;&lt;a name=&quot;firmware&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;F&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;irmware&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;The test fixture uses an arduino library called &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Telemetrix&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;. It can easily be installed to the test fixture using the &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Arduino&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; IDE, or with the &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Install.ps1&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; or &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;UpdateFirmware.ps1&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; scripts located in the &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Scripts&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; folder. To run the script from the GUI, select &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Update Firmware&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; from the &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Settings&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; menu. This will attempt to download and update the &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;arduino_cli&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; tool, compile the firmware, and upload it to the test fixture. The basic steps for updating the firmware are listed below:&lt;/span&gt;&lt;/p&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;An internet connection may be required if the necessary files have not already been downloaded.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;Ensure that the test fixture is connected to the computer but is not connected to the application.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;Open the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Settings&lt;/span&gt; menu and make sure that &lt;span style=&quot; font-family:'Courier New';&quot;&gt;COM Port&lt;/span&gt; and &lt;span style=&quot; font-family:'Courier New';&quot;&gt;arduino_instance_id&lt;/span&gt; are set to the correct values. These will be the values used to upload the firmware. Press &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Save&lt;/span&gt; to save the settings.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;From the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Settings&lt;/span&gt; menu, select &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Update Firmware&lt;/span&gt;. This will start the firmware update process and its progress will be displayed in the console window. (See the image below)&lt;/li&gt;&lt;/ol&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;img src=&quot;file:///c:\Users\dhaha\Documents\Work\Testers\EAX-Python-Interface\images\FirmwareUpdate.png&quot; alt=&quot;alt text&quot; /&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="source">
          <url>
           <string>qrc:/resources/docs/USAGE.html</string>
          </url>
         </property>
         <property name="searchPaths">
          <stringlist>
           <string>docs</string>
           <string>images</string>
          </stringlist>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabWidgetPage6">
      <attribute name="title">
       <string>Settings</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_4">
       <item>
        <widget class="QTextBrowser" name="textBrowser_settings">
         <property name="html">
          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;title&gt;Settings&lt;/title&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Segoe UI'; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;h1 style=&quot; margin-top:18px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a name=&quot;settings&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:xx-large; font-weight:700;&quot;&gt;S&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:xx-large; font-weight:700;&quot;&gt;ettings&lt;/span&gt;&lt;/h1&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;The settings for this application are stored in the windows registry under the key &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;Computer\Hkey_Current_User\Software\Detex Corp\EAX Interface&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;. The settings can be modified by clicking on the settings menu item in the main window. The settings can also be edited by opening the registry editor and navigating to the key mentioned above.&lt;/span&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:14px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a name=&quot;descriptions-for-the-settings&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;D&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;escriptions for the settings&lt;/span&gt;&lt;/h3&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;serial_port: The serial port that is connected to the device. Example: &amp;quot;COM8&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;programmer_serial_number: The serial number of the programmer. Example: &amp;quot;1E660&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;chip_part: The part number of the chip on the device. Example: &amp;quot;PIC16F627A&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;last_user: The last user who used the software. Example: &amp;quot;dmh&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;testing_speed: The speed of testing in Hz. Example: 1584.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;auto_test: If set to true, the software will automatically start testing when it starts up.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;font_family: The font family used for display text. Example: &amp;quot;Segoe UI&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;font_size: The size of the font. Example: 12.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;font_weight: The weight of the font. Example: &amp;quot;normal&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;skip_login: If set to true, the software will not prompt for a user login.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;auto_connect: If set to true, the software will automatically attempt to connect to the device on startup.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;arduino_instance_id: The instance ID of the Arduino software. Example: 15.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;debug: If set to true, the software will log extra information for debugging purposes.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;firmware_folder: The path to the folder containing the device firmware. If empty, the software will look in the default location.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;inactivity_delay: The delay in minutes before the software will automatically log off the current user. Example: 3.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;bg_color: The background color of the software, specified as a hex color. Example: &amp;quot;#000000&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;fg_color: The foreground color of the software, specified as a hex color. Example: &amp;quot;#ffffff&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;arduino_wait: The time in seconds to wait for the Arduino software to start. Example: 2.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;shutdown_on_exception: If set to true, the software will automatically shut down if it encounters an exception.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;auto_find: If set to true, the software will automatically find and connect to the device on startup.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;sleep_tune: The delay in seconds to wait for tuning to complete. Example: 1e-06.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;firmware_location: The path to the firmware file. Example: &amp;quot;./firmware&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;full_screen: If set to true, the software will start in full screen mode.&lt;/li&gt;&lt;/ul&gt;
&lt;pre style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;{&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;serial_port&amp;quot;:&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;COM8&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;programmer_serial_number&amp;quot;:&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;1E660&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;chip_part&amp;quot;:&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;PIC16F628A&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;last_user&amp;quot;:&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;dmh&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;testing_speed&amp;quot;:&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;0.5,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;auto_test&amp;quot;:&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;true,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;font_family&amp;quot;:&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&amp;quot;Arial&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
