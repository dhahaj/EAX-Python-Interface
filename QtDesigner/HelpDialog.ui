     <widget class="QWidget" name="tabWidgetPage5">
      <attribute name="title">
       <string>Usage</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_2">
       <item>
        <widget class="QTextBrowser" name="textBrowser_usage">
         <property name="html">
          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Segoe UI'; font-size:11pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;h1 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:xx-large; font-weight:700;&quot;&gt;Usage&lt;/span&gt;&lt;/h1&gt;
&lt;h2 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700;&quot;&gt;Table of Contents&lt;/span&gt;&lt;/h2&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;a href=&quot;#usage&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Usage&lt;/span&gt;&lt;/a&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 2;&quot;&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;a href=&quot;#table-of-contents&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Table of Contents&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;a href=&quot;#installation&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Installation&lt;/span&gt;&lt;/a&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 3;&quot;&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;a href=&quot;#new-features&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;New Features&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;a href=&quot;#gui&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;GUI&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;a href=&quot;#settings&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Settings&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;a href=&quot;#firmware&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Firmware&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;h2 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700;&quot;&gt;Installation&lt;/span&gt;&lt;/h2&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Install the firmware to the test fixture. See the &lt;a href=&quot;#firmware&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Firmware&lt;/span&gt;&lt;/a&gt; section for more information.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The programming software called &lt;span style=&quot; font-family:'Courier New';&quot;&gt;up.exe&lt;/span&gt; provided for by &lt;a href=&quot;https://www.asix.net/&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Asix&lt;/span&gt;&lt;/a&gt; is required for programming.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Install Python 3.7 or later from &lt;a href=&quot;https://www.python.org/&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Python.org&lt;/span&gt;&lt;/a&gt;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Run &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Start.bat&lt;/span&gt; from the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Scrpts&lt;/span&gt; directory to start the application.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Install the required Python package dependencies listed in &lt;span style=&quot; font-family:'Courier New';&quot;&gt;requirements.txt&lt;/span&gt; using the command &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pip install -r requirements.txt&lt;/span&gt;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;A standalone executable can be created using &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pyinstaller&lt;/span&gt;. Install &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pyinstaller&lt;/span&gt; using the command &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pip install pyinstaller&lt;/span&gt;. (Optional)&lt;/li&gt;&lt;/ol&gt;
&lt;p style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The EAX Test Interface is an improvement over the last version. The interface was written in pure Python using the &lt;a href=&quot;https://doc.qt.io/qtforpython-6/&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Pyside6&lt;/span&gt;&lt;/a&gt; library and &lt;a href=&quot;https://www.qt.io/&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Qt&lt;/span&gt;&lt;/a&gt; framwork. The improvements are listed below:&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Using an improved firmware for communicating with the fixture. It includes improvements to both the communication speed and allows for multiple devices to be connected to the same computer.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Install.PS1&lt;/span&gt; script can be used to automatically download and install the latest firmware. Requires an internet connection. See the &lt;a href=&quot;#firmware&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Firmware&lt;/span&gt;&lt;/a&gt; section for more information.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The settings are now stored in a plaint text file called &lt;span style=&quot; font-family:'Courier New';&quot;&gt;settings.json&lt;/span&gt;. This file contains a JSON object that represents all the runtime settings. There should not be any need to modify this file as all the settings can be changed in the application.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The pin assignments are now stored in a plain text file called &lt;span style=&quot; font-family:'Courier New';&quot;&gt;pins.json&lt;/span&gt;. This file contains a JSON object that represents all the pin assignments. There should not be any need to modify this file as all the pin assignments can be changed in the application. The EAX Test Interface is an improvement over the last version. The interface was written in pure Python using the &lt;a href=&quot;https://doc.qt.io/qtforpython-6/&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Pyside6&lt;/span&gt;&lt;/a&gt; and Qt framwork. The improvements are listed below:&lt;/li&gt;&lt;/ul&gt;
&lt;h3 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:large; font-weight:700;&quot;&gt;New Features&lt;/span&gt;&lt;/h3&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Changing the serial numbers for the programmer can be done directly now in the settings menu. See the &lt;a href=&quot;#settings&quot;&gt;&lt;span style=&quot; color:#7cfbfc;&quot;&gt;Settings&lt;/span&gt;&lt;/a&gt; section for more information.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The login process can be skipped by enabling the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Auto Login&lt;/span&gt; setting. Note to avoid the possibility of a user accidentally modifying the settings, a person will still be required to login as an administrator to change the settings.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The application can automatically find the correct USB port by enabling the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Auto Find&lt;/span&gt; setting. It will scan and test all USB ports and automatically connect to the correct one. The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Auto Connect&lt;/span&gt; setting will automatically connect to the fixture when the application is started.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;If for some reason two fixtures are to be connected to the same computer, the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;arduino_instance_id&lt;/span&gt; setting can be changed so that the application will only connect to the fixture with the matching &lt;span style=&quot; font-family:'Courier New';&quot;&gt;arduino_instance_id&lt;/span&gt;. Note that to do this, the firmware will need to be recompilled and uploaded to the test fixture.&lt;/li&gt;&lt;/ol&gt;
&lt;h3 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:large; font-weight:700;&quot;&gt;GUI&lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The main window is composed of a text console, two buttons and two labels. The text console is used for displaying messages, and the buttons are used for programming and testing. The two text labels are used for displaying the status of the USB connection and the currently selected device. The menu bar contains the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;File&lt;/span&gt;, &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Device&lt;/span&gt;, &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Settings&lt;/span&gt; and &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Help&lt;/span&gt; menus. The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;File&lt;/span&gt; menu contains items for logging in and out, connecting and disconnecting from the fixture, and exiting the application. The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Device&lt;/span&gt; menu contains items for selecting the device. The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Settings&lt;/span&gt; menu contains various items for modifying the settings. The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Help&lt;/span&gt; menu contains items for displaying the debugging logs and displaying the about dialog.&lt;/p&gt;
&lt;p style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;img src=&quot;../images/MainWindow.png&quot; alt=&quot;alt text&quot; title=&quot;&quot; /&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:large; font-weight:700;&quot;&gt;Settings&lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The settings can be changed by clicking on the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Modify Settings&lt;/span&gt; menu item. This will open up a new window as shown below. Any changes made on this window will not be applied until the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Save&lt;/span&gt; button is pressed. The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Default&lt;/span&gt; button will reset all the settings to their default values. The dial on the bottom right can be used to change the testing speed. Rotating it CW will increase the speed and CCW will decrease the speed. The exact timing is shown just above the dial, which is specified in ms. The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Debug&lt;/span&gt; checkbox just enables additional debug messages to be printed to the console and to the log file. The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Auto Logoff Delay&lt;/span&gt; is the amount of time in minutes before the application will automatically logoff the current user (note that this is only valid if &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Auto Login&lt;/span&gt; is disabled). The &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Chip&lt;/span&gt; combobox is used to select the particular chip that is populated on the EAX board. This setting can be changed here or by selecting &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Chip Select&lt;/span&gt; from the settings menu. All the items in the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Advanced&lt;/span&gt; section should not be changed unless you know what you are doing. These settings modify how the application interacts with the fixture and the firmware.&lt;/p&gt;
&lt;p style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;img src=&quot;../images/SettingsMenu.png&quot; alt=&quot;alt text&quot; title=&quot;&quot; /&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:large; font-weight:700;&quot;&gt;Firmware&lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The test fixture uses an arduino library called &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Telemetrix&lt;/span&gt;. It can easily be installed to the test fixture using the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Arduino&lt;/span&gt; IDE, or with the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Install.ps1&lt;/span&gt; or &lt;span style=&quot; font-family:'Courier New';&quot;&gt;UpdateFirmware.ps1&lt;/span&gt; scripts located in the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Scripts&lt;/span&gt; folder. To run the script from the GUI, select &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Update Firmware&lt;/span&gt; from the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Settings&lt;/span&gt; menu. This will attempt to download and update the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;arduino_cli&lt;/span&gt; tool, compile the firmware, and upload it to the test fixture. The basic steps for updating the firmware are listed below:&lt;/p&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;An internet connection may be required if the necessary files have not already been downloaded.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Ensure that the test fixture is connected to the computer but is not connected to the application.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Open the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Settings&lt;/span&gt; menu and make sure that &lt;span style=&quot; font-family:'Courier New';&quot;&gt;COM Port&lt;/span&gt; and &lt;span style=&quot; font-family:'Courier New';&quot;&gt;arduino_instance_id&lt;/span&gt; are set to the correct values. These will be the values used to upload the firmware. Press &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Save&lt;/span&gt; to save the settings.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;From the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Settings&lt;/span&gt; menu, select &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Update Firmware&lt;/span&gt;. This will start the firmware update process and its progress will be displayed in the console window. (See the image below)&lt;/li&gt;&lt;/ol&gt;
&lt;p style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;img src=&quot;../images/FirmwareUpdate.png&quot; alt=&quot;alt text&quot; title=&quot;&quot; /&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="source">
          <url>
           <string>qrc:/docs/USAGE.md</string>
          </url>
         </property>
         <property name="searchPaths">
          <stringlist>
           <string>docs</string>
           <string>images</string>
          </stringlist>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabWidgetPage6">
      <attribute name="title">
       <string>Settings</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_4">
       <item>
        <widget class="QTextBrowser" name="textBrowser_settings">
         <property name="html">
          <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Segoe UI'; font-size:11pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;h1 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:xx-large; font-weight:700;&quot;&gt;Settings&lt;/span&gt;&lt;/h1&gt;
&lt;p style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The settings for this application are stored in the windows registry under the key &lt;span style=&quot; font-family:'Courier New';&quot;&gt;Computer\Hkey_Current_User\Software\Detex Corp\EAX Interface&lt;/span&gt;. The settings can be modified by clicking on the settings menu item in the main window. The settings can also be edited by opening the registry editor and navigating to the key mentioned above.&lt;/p&gt;
&lt;h3 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:large; font-weight:700;&quot;&gt;Descriptions for the settings&lt;/span&gt;&lt;/h3&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;serial_port: The serial port that is connected to the device. Example: &amp;quot;COM8&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;programmer_serial_number: The serial number of the programmer. Example: &amp;quot;1E660&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;chip_part: The part number of the chip on the device. Example: &amp;quot;PIC16F627A&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;last_user: The last user who used the software. Example: &amp;quot;dmh&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;testing_speed: The speed of testing in Hz. Example: 1584.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;auto_test: If set to true, the software will automatically start testing when it starts up.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;font_family: The font family used for display text. Example: &amp;quot;Segoe UI&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;font_size: The size of the font. Example: 12.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;font_weight: The weight of the font. Example: &amp;quot;normal&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;skip_login: If set to true, the software will not prompt for a user login.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;auto_connect: If set to true, the software will automatically attempt to connect to the device on startup.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;arduino_instance_id: The instance ID of the Arduino software. Example: 15.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;debug: If set to true, the software will log extra information for debugging purposes.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;firmware_folder: The path to the folder containing the device firmware. If empty, the software will look in the default location.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;inactivity_delay: The delay in minutes before the software will automatically log off the current user. Example: 3.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;bg_color: The background color of the software, specified as a hex color. Example: &amp;quot;#000000&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;fg_color: The foreground color of the software, specified as a hex color. Example: &amp;quot;#ffffff&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;arduino_wait: The time in seconds to wait for the Arduino software to start. Example: 2.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;shutdown_on_exception: If set to true, the software will automatically shut down if it encounters an exception.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;auto_find: If set to true, the software will automatically find and connect to the device on startup.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;sleep_tune: The delay in seconds to wait for tuning to complete. Example: 1e-06.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;firmware_location: The path to the firmware file. Example: &amp;quot;./firmware&amp;quot;.&lt;/li&gt;
&lt;li style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;full_screen: If set to true, the software will start in full screen mode.&lt;/li&gt;&lt;/ul&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;{&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;serial_port&amp;quot;: &amp;quot;COM8&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;programmer_serial_number&amp;quot;: &amp;quot;1E660&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;chip_part&amp;quot;: &amp;quot;PIC16F628A&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;last_user&amp;quot;: &amp;quot;dmh&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;testing_speed&amp;quot;: 0.5,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;auto_test&amp;quot;: true,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;font_family&amp;quot;: &amp;quot;Arial&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;font_size&amp;quot;: 14,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;font_weight&amp;quot;: &amp;quot;normal&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;font_color&amp;quot;: &amp;quot;#000000&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;skip_login&amp;quot;: true,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;auto_connect&amp;quot;: false,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;arduino_instance_id&amp;quot;: 1,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;debug&amp;quot;: true,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;firmware_folder&amp;quot;: &amp;quot;&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;firmware_location&amp;quot;: &amp;quot;./firmware&amp;quot;,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;shutdown_on_exception&amp;quot;: true,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;auto_find&amp;quot;: true,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;sleep_tune&amp;quot;: 1e-06,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;arduino_wait&amp;quot;: 2,&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;    &amp;quot;full_screen&amp;quot;: false&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;}&lt;/span&gt;&lt;/pre&gt;
&lt;p style=&quot; margin-top:7px; margin-bottom:7px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;img src=&quot;../images/SettingsMenu.png&quot; alt=&quot;alt text&quot; title=&quot;&quot; /&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="source">
          <url>
           <string>qrc:/docs/Settings.md</string>
          </url>
         </property>
         <property name="searchPaths">
          <stringlist>
           <string>images</string>
           <string>docs</string>
          </stringlist>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
