&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;pins&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;The pin configuration.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;h3 style=&quot; margin-top:14px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;a name=&quot;firmware-configuration&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;F&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:large; font-weight:700;&quot;&gt;irmware Configuration&lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;The firmware configuration defined in &lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;config.yaml&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt; is used to configure the filenames, versions, and paths of the firmware. The firmware configuration is stored in a YAML object with the following format:&lt;/span&gt;&lt;/p&gt;
&lt;pre style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;...&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;&lt;br /&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;firmware:&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;path:&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;./firmware&lt;/span&gt;&lt;/pre&gt;
&lt;pre style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;default_device:&lt;/span&gt;&lt;span style=&quot; font-family:'Courier New'; font-size:14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe WPC','Segoe UI','system-ui','Ubuntu','Droid Sans','sans-serif'; font-size:14px;&quot;&gt;EAX500&lt;/span&gt;&lt;/pre&gt;
